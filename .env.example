# Copy to .env for local development.
#
# Every setting is read through app/core/config.py — never read os.environ directly in
# business code (CODESTYLE.md §1). Environment variable names are UNPREFIXED.
#
# To namespace them (for example if this service shares a host with something else that
# exports LLM_* or SKILLS_*), export COBOL_ENV_PREFIX=COBOL_ and every name below gains that
# prefix. That variable is read at process start, so it must be exported rather than set here.

# ---------------------------------------------------------------- storage
DATA_ROOT=./data
RUN_TTL_DAYS=7
# How stale a mirror may be before a run refetches it. 0 always fetches (what the explicit
# "pull from remote" action uses); the default trades a few minutes of freshness for skipping a
# network round trip on a mainframe-sized repository.
MIRROR_MAX_AGE_SECONDS=300

# ------------------------------------------------------------------- auth
# How a caller is identified. The console has no login step: identity is established by
# whatever proxies to this service and the server reads it from a header it trusts.
#   trusted_header  (default) identity arrives in TRUSTED_ACTOR_HEADER, set by the proxy.
#                   The dev proxy sets it; in production the SSO gateway does.
#                   SAFE ONLY IF THE PORT IS UNREACHABLE EXCEPT THROUGH THAT PROXY —
#                   the header is not verified, so a direct caller could forge it.
#   api_key         a shared key per caller, in Authorization or X-API-Key. Use when no
#                   proxy is in front. Configure keys below.
#   disabled        everyone is an admin. Local development only.
#   e2e_token       RESERVED for the SSO integration: the gateway token arrives in the header
#                   and is verified server-side. Not implemented yet — selecting it returns
#                   501 rather than pretending to work.
AUTH_MODE=trusted_header
TRUSTED_ACTOR_HEADER=E2E-token
# Role given to a caller the trusted header identifies. Narrow to `analyst` on a host where
# not every user should be able to delete runs; per-user roles arrive with SSO claims.
TRUSTED_DEFAULT_ROLE=admin

# Only read when AUTH_MODE=api_key. Comma-separated key:role pairs; a bare key means analyst.
#   viewer   read runs, artifacts, knowledge base
#   analyst  + start and cancel runs, reindex the knowledge base
#   reviewer + approve (reserved; approvals are backend-only for now)
#   admin    + delete runs, run GC, reload the repository registry
# Give each caller its own key: there is no user table, so the key IS the identity and it is
# what makes the audit log attributable. See docs/DESIGN.md §6.3.
# API_KEYS=demo-key:admin,viewer-key:viewer

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -------------------------------------------------------------------- llm
#   LLM_PROVIDER  openai | anthropic
#                 - openai    -> POST /v1/chat/completions  (the common case)
#                 - anthropic -> POST /v1/messages          (same provider, /anthropic)
# Switching provider changes nothing else in the codebase; build_model() is the only reader.
LLM_PROVIDER=openai
LLM_BASE_URL=https://gateway.example.com/v1
LLM_MODEL=<model-name>       # from your provider's catalogue

# Both values are REQUIRED: the project names no vendor, so there is no default that would be
# right for every deployment. Examples of the two supported shapes:
#   openai     LLM_BASE_URL=https://gateway.example.com/v1        (chat completions)
#   anthropic  LLM_BASE_URL=https://gateway.example.com/anthropic (messages)
# The credential may go here (LLM_AUTH_TOKEN, below) or in the process environment. The
# environment wins, so an exported key is never shadowed by a placeholder in this file — but a
# file holding a secret must be 0600:
#   chmod 600 .env
# LLM_AUTH_TOKEN=<your-key>

# The credential, in preference order. Naming the variable explicitly wins over all of them,
# and a variable in the environment always beats the same name set in this file.
#   1. LLM_API_KEY_ENV=<name>      # most explicit: name whatever your secret store uses
#   2. LLM_AUTH_TOKEN              # the neutral name this project expects (works here too)
#   3. OPENAI_API_KEY / ANTHROPIC_AUTH_TOKEN   # compatibility fallbacks, so a host whose
#                                              # credential is already provisioned under a
#                                              # tool-specific name needs no change
# LLM_API_KEY_ENV=LLM_AUTH_TOKEN
# LLM_API_KEY=                     # discouraged: prefer the environment over a file

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=600

# Optional per-skill model overrides. The analysis skill carries the reasoning load; the
# deliverable skills tolerate a cheaper, faster model. Both are applied; leave either unset to
# fall back to LLM_MODEL.
# ANALYSIS_MODEL=<stronger-model>     # the analysis skill carries the reasoning load
# ARTIFACT_MODEL=<cheaper-model>      # deliverable generation tolerates a faster model

# ------------------------------------------------------------------- skills
# One subdirectory per skill, each containing a SKILL.md. Mounted read-only for the agent at
# /skills and advertised through progressive disclosure. The default resolves to
# <repo>/backend/skills, which is correct for a source checkout.
# SKILLS_DIR=/opt/cobol-agent/skills
# SKILLS_ENABLED=false             # kill switch: run the agent with no skills at all

# ------------------------------------------------------------- repositories
# Registry file listing repositories and the NAME of the env var holding each PAT —
# credentials are never stored in the file itself. See backend/repos.example.yaml.
# REPOS_FILE=/etc/cobol-agent/repos.yaml

# Convenience single-repository override, used by the demo and the integration test. It feeds
# the same registry entry shape as the yaml file, so everything downstream behaves identically:
# DEMO_REPO_URL=/path/to/repo
# DEMO_REPO_BRANCH=main

# ------------------------------------------------------------------ budgets
MAX_PARALLEL_ARTIFACTS=3
MAX_TOOL_CALLS=400
MAX_WALL_SECONDS=2700
MAX_SLICE_LINES=400

# ------------------------------------------------------------------- misc
GIT_BIN=git
LOG_LEVEL=INFO
